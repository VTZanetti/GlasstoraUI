{
  "name": "glasstora",
  "version": "0.2.0",
  "description": "Monochrome liquid glass UI components for Vue 3, with real refraction and a global light source.",
  "type": "module",
  "license": "MIT",
  "author": "Vitor Zanetti",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VTZanetti/GlasstoraUI.git"
  },
  "homepage": "https://glasstora.zanetti.tech/",
  "bugs": {
    "url": "https://github.com/VTZanetti/GlasstoraUI/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "ui",
    "components",
    "component-library",
    "glassmorphism",
    "liquid-glass",
    "monochrome",
    "terminal",
    "dark-theme",
    "typescript"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/glasstora.cjs",
  "module": "./dist/glasstora.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/glasstora.js",
      "require": "./dist/glasstora.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./resolver": {
      "types": "./dist/resolver.d.ts",
      "import": "./dist/resolver.js",
      "require": "./dist/resolver.cjs"
    },
    "./global": {
      "types": "./dist/global.d.ts"
    },
    "./style.css": "./dist/style.css",
    "./css/*.css": "./dist/css/*.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite -c vite.demo.config.ts",
    "build": "vite build && vite build -c vite.styles.config.ts",
    "build:demo": "vite build -c vite.demo.config.ts",
    "preview:demo": "vite preview -c vite.demo.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:dist",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  }
}
